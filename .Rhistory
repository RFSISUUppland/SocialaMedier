library(ggplot2)
library(dplyr)
library(tidyr)
library(stringr)
library(magrittr)
library(knitr)
library(readxl)
library(openxlsx)
library(janitor)
library(lubridate)
result <- data %>%
mutate(
publish_time = ymd(publish_time),             # omvandla till datum
month = floor_date(publish_time, "month")     # extrahera månadsnivå
) %>%
group_by(month) %>%
summarise(
total_views = sum(views, na.rm = TRUE),
posts = n(),
avg_views_per_post = total_views / posts
)
View(result)
